# Frontend Firebase client configuration (Firebase Console > Project settings > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Firebase Admin service account JSON, pasted as one JSON object (private key may use \n escapes)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
PORT=4000
WEB_ORIGIN=http://localhost:3000
QR_TOKEN_SECRET=replace-with-a-long-random-secret
